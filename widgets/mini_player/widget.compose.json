        "set_previous": {
            "method": "POST",
            "path": "/:deviceId/previous"
        },
        "set_volume": {
            "method": "POST",
            "path": "/:deviceId/volume"
        },
        "set_shuffle": {
            "method": "POST",
            "path": "/:deviceId/shuffle"
        },
        "set_repeat": {
