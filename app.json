  "discovery": {
    "appletv-airplay": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_airplay",
        "protocol": "tcp"
      },
      "id": "{{host}}",
      "conditions": [
        [
          {
            "field": "txt.model",
            "match": {
              "type": "regex",
              "value": "AppleTV\\d+,\\d+"
            }
          }
        ]
      ]
    },
    "appletv-companion-link": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_companion-link",
        "protocol": "tcp"
      },
      "id": "{{host}}",
      "conditions": [
        [
          {
            "field": "txt.rpmd",
            "match": {
              "type": "regex",
              "value": "AppleTV\\d+,\\d+"
            }
          }
        ]
      ]
    },
    "homepod": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_airplay",
        "protocol": "tcp"
      },
      "id": "{{host}}",
      "conditions": [
        [
          {
            "field": "txt.model",
            "match": {
              "type": "regex",
              "value": "AudioAccessory(1|6),\\d{1}"
            }
          }
        ]
      ]
    },
    "homepod-mini": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_airplay",
        "protocol": "tcp"
      },
      "id": "{{host}}",
      "conditions": [
        [
          {
            "field": "txt.model",
            "match": {
              "type": "regex",
              "value": "AudioAccessory5,\\d{1}"
            }
          }
        ]
      ]
    }
  }
