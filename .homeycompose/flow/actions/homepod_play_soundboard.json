        "no": "Spill Soundboard-lyd [[sound]] ved volum [[volume]]",
        "sv": "Spela Soundboard-ljud [[sound]] vid volym [[volume]]",
        "pl": "Odtwórz dźwięk z Soundboard [[sound]] przy głośności [[volume]]",
        "ru": "Воспроизвести звук Soundboard [[sound]] с громкостью [[volume]]",
        "ko": "볼륨 [[volume]]으로 사운드보드 소리 [[sound]] 재생",
        "ar": "تشغيل صوت Soundboard [[sound]] بمستوى الصوت [[volume]]"
    },
    "args": [
        {
            "name": "device",
            "type": "device",
            "filter": "driver_id=homepod|homepod-mini"
        },
        {
            "name": "sound",
            "type": "autocomplete",
            "title": {
                "en": "Sound",
                "nl": "Geluid",
                "da": "Lyd",
                "de": "Ton",
                "es": "Sonido",
                "fr": "Son",
                "it": "Suono",
                "no": "Lyd",
                "sv": "Ljud",
                "pl": "Dźwięk",
                "ru": "Звук",
                "ko": "소리",
                "ar": "صوت"
            }
        },
        {
            "type": "range",
            "name": "volume",
            "min": 0,
            "max": 100,
            "step": 1,
            "label": "%",
            "labelDecimals": 0,
            "value": 50,
            "title": {
                "en": "Volume",
                "nl": "Volume",
                "de": "Lautstärke",
                "fr": "Volume",
                "it": "Volume",
                "sv": "Volym",
                "no": "Volum",
                "es": "Volumen",
                "da": "Lydstyrke",
                "ru": "Громкость",
